{
  "name": "@agencebio/cartobio-front",
  "version": "3.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-sw": "vite build --watch & (sleep 1 && vite preview --port 3000)",
    "build": "npm run build:app",
    "build:app": "vite build",
    "build:widget": "vite build --config vite.widget.config.js --mode lib",
    "build:widget-demo": "vite build --config vite.widget.config.js",
    "postbuild": "npm run build:widget && npm run build:widget-demo",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest --coverage",
    "posttest": "eslint ./src && npm run prettier:check",
    "changelog": "conventional-changelog -i CHANGELOG.md -s -r 1 -u",
    "prettier:format": "prettier --write \"**/*.{vue,ts,tsx,js,md,json,css,yaml}\"",
    "prettier:check": "prettier --check \"**/*.{vue,ts,tsx,js,md,json,css,yaml}\""
  },
  "engines": {
    "node": "^24.0.0"
  },
  "dependencies": {
    "@agencebio/rosetta-cultures": "^2.6.0",
    "@algolia/autocomplete-js": "^1.19.9",
    "@algolia/autocomplete-theme-classic": "^1.19.9",
    "@gouvfr/dsfr": "^1.14.4",
    "@sentry/vue": "^10.67.0",
    "@turf/bbox": "^7.3.5",
    "@turf/bbox-polygon": "^7.3.5",
    "@turf/difference": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/intersect": "^7.3.5",
    "@turf/kinks": "^7.3.5",
    "@turf/union": "^7.3.5",
    "@unhead/vue": "^3.2.2",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "driver.js": "^1.8.0",
    "esbuild": "^0.28.1",
    "fuse.js": "^7.5.0",
    "geometric": "^3.0.9",
    "jsts": "^2.12.1",
    "ol": "^10.9.0",
    "ol-ext": "^4.0.38",
    "ol-mapbox-style": "^13.4.1",
    "pinia": "^4.0.2",
    "proj4": "^2.20.9",
    "remixicon": "^4.9.1",
    "reproject": "^1.2.7",
    "vue": "^3.5.41",
    "vue-matomo": "^4.2.0",
    "vue-router": "^5.2.0",
    "vue3-toastify": "^0.2.9",
    "xlsx": "git+https://git.sheetjs.com/sheetjs/sheetjs.git#2669c7c"
  },
  "devDependencies": {
    "@agencebio/cartobio-types": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-legacy": "^8.2.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pages": "^0.33.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "postcss": {
    "plugins": {
      "postcss-preset-env": {
        "features": {
          "gap-properties": 1,
          "nesting-rules": true
        }
      },
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8",
    "since 2019"
  ]
}
